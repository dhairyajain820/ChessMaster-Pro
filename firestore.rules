rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidGame(data, userId) {
      return data.userId == userId &&
             data.gameId is string && data.gameId.size() > 0 &&
             data.opponentName is string &&
             data.gameResult in ['WIN', 'LOSS', 'DRAW'] &&
             data.movesSan is string;
    }

    match /users/{userId}/games/{gameId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidGame(request.resource.data, userId);
      allow update: if isOwner(userId) && isValidGame(request.resource.data, userId);
      allow delete: if isOwner(userId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
